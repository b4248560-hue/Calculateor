def simple_calculator():
    num1 = float(input("أدخلي الرقم الأول: "))
    num2 = float(input("أدخلي الرقم الثاني: "))
    operation = input("اختاري العملية (+, -, *, /): ")
    
    if operation == '+':
        print(f"النتيجة: {num1 + num2}")
    elif operation == '-':
        print(f"النتيجة: {num1 - num2}")
    elif operation == '*':
        print(f"النتيجة: {num1 * num2}")
    elif operation == '/':
        if num2 != 0:
            print(f"النتيجة: {num1 / num2}")
        else:
            print("خطأ: لا يمكن القسمة على صفر!")
    else:
        print("عملية غير صحيحة!")

simple_calculator()
